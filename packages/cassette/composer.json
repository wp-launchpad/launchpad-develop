{
  "name": "wp-launchpad/cassette",
  "description": "Cassette module for Launchpad",
  "keywords": [
    "wordpress"
  ],
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "CrochetFeve0251"
    }
  ],
  "autoload": {
    "psr-4": {
      "LaunchpadCassette\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LaunchpadCassette\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "wp-media/phpunit": "^3.0"
  },
  "scripts": {
    "test-integration": "\"vendor/bin/phpunit\" --testsuite integration --colors=always --configuration tests/Integration/phpunit.xml.dist --exclude-group AdminOnly",
    "run-tests": [
      "@test-integration"
    ]
  },
  "require": {
    "wp-launchpad/phpunit-wp-hooks": "^3.1",
    "wp-launchpad/filesystem": "^3.1",
    "ext-yaml": "*"
  }
}
