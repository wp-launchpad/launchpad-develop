{
    "name": "wp-launchpad/front",
    "description": "Front library for Launchpad framework",
    "license": "proprietary",
    "type": "library",
    "authors": [
        {
            "name": "coquardcyr",
            "email": "coquardcyr@gmail.com"
        }
    ],
    "require": {
        "wp-launchpad/bud-assets": "^3.1",
        "wp-launchpad/core": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.5 || ^8 || ^9",
        "wp-media/phpunit": "^3.0",
        "wp-launchpad/cli": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "LaunchpadFront\\": "inc/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaunchpadFront\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-feature/ll-subscribers": "3.1-dev"
        }
    }
}
